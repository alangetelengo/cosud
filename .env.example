APP_NAME="COSUD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Version applicative COSUD (affichée footer / php artisan cosud:version)
COSUD_VERSION=1.0.0
COSUD_RELEASED_AT=2026-08-26

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=cosud
LOG_STACK=cosud
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cosud
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (comme Progcaisse - Gmail)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Notifications courrier : e-mail en plus de la cloche (désactivé par défaut)
COSUD_COURRIER_NOTIFICATIONS_MAIL=false
SUBJECT=COSUD

# SMS MTN (comme Progcaisse)
MTN_BASE_URL=https://api.mtn.com
MTN_API_KEY=
MTN_COUNTRY_CODE=COG
MTN_SENDER=ACSI-SMS

# SMS aux expéditeurs (Wirepick | Infobip — même API que SIFEC)
COSUD_SMS_PROVIDER=wirepick
COSUD_SMS_SENDER_ID=ETAT-CIVIL
COSUD_SMS_WIREPICK_CLIENT=
COSUD_SMS_WIREPICK_PASSWORD=
# COSUD_SMS_WIREPICK_ENDPOINT=https://api.wirepick.com/httpsms/send
# COSUD_SMS_WIREPICK_HTTP_METHOD=get
# Infobip (si COSUD_SMS_PROVIDER=infobip) :
# COSUD_SMS_INFOBIP_API_KEY=App xxx
# COSUD_SMS_INFOBIP_SEND_URL=https://mpn66j.api.infobip.com/sms/2/text/advanced

# WhatsApp multi-driver : log | meta | infobip
COSUD_WHATSAPP_DRIVER=log
COSUD_WHATSAPP_ALSO_SMS=false
# Secret optionnel webhook entrant POST /webhooks/infobip/whatsapp
# COSUD_WHATSAPP_WEBHOOK_SECRET=

# Meta Cloud API (sandbox developers.facebook.com — gratuit pour tester)
# COSUD_WHATSAPP_META_TOKEN=
# COSUD_WHATSAPP_META_PHONE_NUMBER_ID=
# COSUD_WHATSAPP_META_API_VERSION=v21.0
# COSUD_WHATSAPP_META_TEMPLATE_NAME=
# COSUD_WHATSAPP_META_TEMPLATE_LANGUAGE=fr

# Infobip WhatsApp (prod / essai Infobip)
# COSUD_WHATSAPP_INFOBIP_API_KEY=App xxx
# COSUD_WHATSAPP_INFOBIP_BASE_URL=https://mpn66j.api.infobip.com
# COSUD_WHATSAPP_FROM=2420XXXXXXXX
# COSUD_WHATSAPP_TEMPLATE_NAME=cosud_alerte
# COSUD_WHATSAPP_TEMPLATE_LANGUAGE=fr

# SMS Vonage (legacy, non utilisé pour les expéditeurs)
VONAGE_KEY=
VONAGE_SECRET=

# Tesseract OCR (optionnel)
TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Plan de classement au seed : none (aucun dossier) | dg_only (démo DG, défaut) | full (multi-directions)
SEED_PLAN_CLASSEMENT=dg_only
