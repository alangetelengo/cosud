/w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>003064f@acsi.cg</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>BRIGITTE ESSONGA</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>SEC-DDSAIT</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Secrétaire DAF</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>003063e@acsi.cg</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>RUTH JEMIMAH MAYELA</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2160"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>SEC-DAF</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>2. Vue d’ensemble des circuits</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.1 Circuit B — Courriers généraux</w:t></w:r></w:p><w:p><w:r><w:t>Enchaînement typique : Enregistrement (auto) → Notification (auto) → Instruction DG → Traitement particulière (projet) → Validation DG → Création départ brouillon (Lucienne).</w:t></w:r></w:p><w:p><w:r><w:t>Variantes : (1) le DG répond lui-même et signe (clôture) ; (2) le DG rejette le projet (retour à Traitement particulière) ; (3) instruction par le directeur de la structure destinataire.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.2 Circuit A — Factures prestataires</w:t></w:r></w:p><w:p><w:r><w:t>Enchaînement typique : Enregistrement (auto) → Instructions DG (± agent confié) → [Traitement dossiers → AC] ou saut direct si agent AC → AC envoie chèque au DG → DG signe (scan + notif fournisseur) → AC → caissiers → Retour caisse → Preuve de paiement → Clôture.</w:t></w:r></w:p><w:p><w:r><w:t>Variante : à l’étape Instructions DG, le DG peut « Répondre moi-même et signer » (clôture immédiate du circuit facture, sans bascule AC/chèque).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>3. Test A — Circuit « Courriers généraux »</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>3.1 Exemple de courrier à saisir</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="4320"/><w:gridCol w:w="4320"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/><w:shd w:fill="1F4E79" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="FFFFFF"/><w:sz w:val="20"/></w:rPr><w:t>Champ</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/><w:shd w:fill="1F4E79" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="FFFFFF"/><w:sz w:val="20"/></w:rPr><w:t>Valeur</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Sens</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Arrivée</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Type de courrier</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Administratif (ou Invitation / Autre — circuit général)</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Expéditeur</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Ministère de la Fonction Publique</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Objet</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Demande de mise à jour de l'organigramme de la Direction</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Date du courrier</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Date du jour</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Référence expéditeur</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>MFP/CAB/2026/00412</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Pièce jointe</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>N'importe quel PDF de test</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>3.2 Cas A1 — Chemin nominal (projet Lucienne → validation DG → départ brouillon)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Se connecter avec Lucienne (003144s@acsi.cg) → Courriers → Nouveau courrier arrivée (courriers/create?sens=arrivee) → saisir le courrier ci-dessus → Enregistrer.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Fiche du courrier → onglet Historique circuit.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Étape en cours = « Instruction DG » (enregistrement + notification déjà auto-validés). Pas de bouton « Valider l’étape » générique pour cette étape d’instruction.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Se connecter avec le DG (003057w@acsi.cg) → ouvrir la cloche de notifications.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Pas de triple notification pour le même enchaînement (bug historique corrigé).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Ouvrir le courrier → panneau Circuit métier : formulaire « A — Instruire le dossier » (instructions obligatoires ; agent confié facultatif — laisser vide ici).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Saisir par ex. : « Merci de préparer une réponse indiquant que l’organigramme mis à jour sera transmis sous 15 jours. » → Enregistrer les instructions.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Étape = « Traitement par la particulière ». Dans Actions : formulaire de soumission du projet (document + objet). Pas de bouton générique « Valider l’étape ». « Relancer le responsable » est visible pour le DG (ce n’est plus son tour).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Avant les instructions (rejouer sur un autre courrier si besoin) : en tant que Lucienne à l’étape Instruction DG, vérifier le panneau Actions.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Message « En attente des instructions du DG / directeur » — pas le texte « Enregistrez vos instructions… » réservé au DG.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Avec Lucienne à Traitement particulière → joindre un document de réponse → Soumettre le projet de réponse au DG. Ne pas cocher confidentialité / agent destinataire (champs interdits à cette étape).</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Étape = « Validation de la réponse » (DG).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Avec le DG → Actions : « Valider et envoyer à Lucienne pour créer le courrier de réponse » (pas « Créer le départ » / « Répondre moi-même » à cette étape après validation).</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Étape = « Création du départ (particulière) ».</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Avec Lucienne → formulaire « Créer le courrier départ (brouillon) » : objet, destinataire (structure ou agent si confidentiel) → Créer le brouillon.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Courrier départ créé en brouillon ; circuit arrivée avancé / clôturé selon le moteur (plus d’étape « en cours » ou étape suivante selon config). Pas de nouveau clic « Valider l’étape » pour matérialiser la création.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>3.3 Cas A2 — DG répond lui-même et signe (bypass particulière)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Créer un nouveau courrier administratif (Lucienne) → se connecter en DG à l’étape Instruction DG ou après instruction à Traitement particulière.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Dans Actions → « Répondre moi-même et signer » → joindre le document, choisir destinataire (structure ou agent si confidentiel) → Créer et signer.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Courrier départ créé au statut signé ; circuit arrivée clôturé (pas de suite particulière / validation).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>3.4 Cas A3 — DG rejette le projet de Lucienne</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Reprendre A1 jusqu’à la soumission du projet → en DG : Rejeter avec motif (ex. « Reformuler le 2e paragraphe »).</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Retour à « Traitement par la particulière » ; motif visible pour Lucienne ; elle peut resoumettre un nouveau document.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>3.5 Cas A4 — Relancer (circuit général)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>À l’étape Instruction DG connecté en DG : vérifier le panneau Circuit métier.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Bouton « Relancer le responsable » absent (ce serait se relancer soi-même).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListNumber"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>Après instructions, à Traitement particulière, toujours en DG.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/><w:color w:val="0F6E56"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Attendu : </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/></w:rPr><w:t>« Relancer le responsable » visible (relance utile vers Lucienne).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>4. Test B — Circuit « Factures prestataires »</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>4.1 Exemple de courrier à saisir</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="4320"/><w:gridCol w:w="4320"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/><w:shd w:fill="1F4E79" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="FFFFFF"/><w:sz w:val="20"/></w:rPr><w:t>Champ</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/><w:shd w:fill="1F4E79" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:color w:val="FFFFFF"/><w:sz w:val="20"/></w:rPr><w:t>Valeur</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Sens</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Arrivée</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Type de courrier</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:sz w:val="18"/></w:rPr><w:t>Facture</w:t></w:r></